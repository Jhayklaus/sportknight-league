# Secret PIN required to update fixture scores.
# Copy this file to .env.local and change the value.
LEAGUE_PIN=1234

# Optional: directory where scores.json is stored (defaults to ./data).
# Point this at a persistent volume when deploying.
# LEAGUE_DATA_DIR=/var/data/sportknight

# Redis backend (required on Vercel/serverless — filesystem there is read-only).
# Set either pair; the Vercel Upstash integration adds these automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: require a shared code to create a new league (leave unset = open).
# LEAGUE_CREATION_CODE=

# Optional: which league is served at the site root.
# ROOT_LEAGUE_SLUG=sportknight
